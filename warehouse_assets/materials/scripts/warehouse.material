material Warehouse/ConcreteFloor
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient 0.85 0.85 0.85 1.0
      diffuse 0.9 0.9 0.9 1.0
      specular 0.2 0.2 0.2 1.0 16.0

      texture_unit
      {
        texture concrete_floor.png
        scale 0.08 0.08
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

